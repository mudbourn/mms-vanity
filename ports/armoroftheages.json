    "anubis_armor": {
      "slots": {
        "head": "client/models/anubis_armor/HeadAnubisArmorModel.java",
        "chest": "client/models/anubis_armor/ChestAnubisArmorModel.java",
        "legs": "client/models/anubis_armor/LegsAnubisArmorModel.java",
        "feet": "client/models/anubis_armor/FeetAnubisArmorModel.java"
      },
      "slim_method": "createSlimLayerDefinition",
      "texture": "armoroftheages:textures/models/armor/{skin}anubis_armor.png",
      "slim_texture": "armoroftheages:textures/models/armor/{skin}anubis_armor_slim.png",
      "animations": {
        "head": {
          "earRight": {
            "relative": true,
            "x_rot": "0.1 * sinpi(age / 35)"
          },
          "earLeft": {
            "relative": true,
            "x_rot": "0.1 * sinpi(age / 35)"
          },
          "ribbonRight": {
            "z_rot": "0.05 * sinpi((age - 15) / 50)"
          },
          "ribbonLeft": {
            "z_rot": "-0.05 * sinpi((age - 15) / 50)"
          }
        },
        "chest": {
          "collar_back": {
            "x_rot": "-1.5708 + 0.08 * (1 + sinpi(age / 40))"
          },
          "cross_a": {
            "x": "(8.5 + 2 * sinpi(age / 40)) * cospi(2 * 0.5 * (age) / 40)",
            "y": "30 + (8.5 + 2 * sinpi((age + 10) / 30)) * sinpi(2 * -0.5 * (age) / 40)"
          },
          "cross_b": {
            "x": "(8 + 2 * sinpi(age / 70)) * cospi(2 * 0.45 * (age + 5) / 40)",
            "y": "30 + (8 + 2 * sinpi((age + 10) / 40)) * sinpi(2 * 0.45 * (age + 25) / 40)"
          },
          "cross_c": {
            "x": "(9 + 2 * sinpi((age + 25) / 30)) * cospi(2 * 0.55 * (age + 25) / 40)",
            "y": "30 + (9 + 2 * sinpi((age + 5) / 50)) * sinpi(2 * 0.55 * (age + 30) / 40)"
          },
          "cross_d": {
            "x": "(8 + 2 * sinpi((age + 30) / 80)) * cospi(2 * 0.42 * (age + 20) / 40)",
            "y": "30 + (8 + 2 * sinpi(age / 50)) * sinpi(2 * 0.42 * (age + 20) / 40)"
          }
        },
        "legs": {
          "ribbonLegs": {
            "x_rot": "-abs(0.05 + 1.02 * right_leg.x_rot) + 0.05 * (1 + sinpi(age / 40))"
          }
        }
      }
    },
